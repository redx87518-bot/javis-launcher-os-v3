<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/javis_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WHATSAPP"
        android:textColor="@color/javis_red"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_whatsapp_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WhatsApp Integration"
        android:textColor="@color/javis_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/javis_card"
        app:cardCornerRadius="12dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_whatsapp_connection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disconnected"
                android:textColor="@color/javis_red"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_whatsapp_link"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Link WhatsApp"
                android:backgroundTint="@color/javis_green"
                android:textColor="@color/white"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_test_connection"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Test Connection"
                android:backgroundTint="@color/javis_surface"
                android:textColor="@color/javis_text_primary"
                android:enabled="false"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_whatsapp_disconnect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Disconnect"
                android:backgroundTint="@color/javis_red"
                android:textColor="@color/white"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_clear_session"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Clear Session"
                android:backgroundTint="@color/javis_surface"
                android:textColor="@color/javis_text_primary"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_phone_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/javis_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AGENT PERMISSIONS"
        android:textColor="@color/javis_red"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/javis_card"
        app:cardCornerRadius="12dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/cb_read_incoming"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Read incoming messages"
                android:textColor="@color/javis_text_primary"
                android:checked="false"/>

            <CheckBox
                android:id="@+id/cb_read_unread"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Read unread messages"
                android:textColor="@color/javis_text_primary"
                android:checked="false"/>

            <CheckBox
                android:id="@+id/cb_send_messages"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Send messages"
                android:textColor="@color/javis_text_primary"
                android:checked="true"/>

            <CheckBox
                android:id="@+id/cb_read_aloud"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Read messages aloud"
                android:textColor="@color/javis_text_primary"
                android:checked="false"/>

            <CheckBox
                android:id="@+id/cb_auto_reply"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Allow automatic replies"
                android:textColor="@color/javis_text_primary"
                android:checked="false"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_whatsapp_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="JAVIS never stores your WhatsApp password or authentication secrets. Messages are processed locally and only sent to your configured AI provider for response generation."
        android:textColor="@color/javis_text_secondary"
        android:textSize="11sp"
        android:padding="12dp"
        android:background="@color/javis_surface"/>

</LinearLayout>
