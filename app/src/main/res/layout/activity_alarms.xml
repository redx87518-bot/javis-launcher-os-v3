<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/javis_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ALARM"
        android:textColor="@color/javis_red"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scheduled Alerts"
        android:textColor="@color/javis_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-light"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_alarm_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:gravity="center"
        android:textColor="@color/javis_text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:background="@drawable/bg_card"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:gravity="center"
        android:text="You can also say:\n&quot;Set alarm for 7 AM&quot;"
        android:textColor="@color/javis_green"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:background="@drawable/bg_card"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_add"
        android:contentDescription="Add alarm"
        app:backgroundTint="@color/javis_red"
        app:tint="@color/white" />

</LinearLayout>
