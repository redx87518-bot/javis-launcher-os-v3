<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/javis_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WHATSAPP"
        android:textColor="@color/javis_red"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_whatsapp_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Integration"
        android:textColor="@color/javis_text_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-light"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tv_whatsapp_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Disconnected"
        android:textColor="@color/javis_red"
        android:textSize="14sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bg_pill"
        android:layout_marginBottom="20dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/javis_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_phone_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone number"
                android:textColor="@color/javis_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_phone_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not linked"
                android:textColor="@color/javis_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tv_session_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session"
                android:textColor="@color/javis_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_session_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No active session"
                android:textColor="@color/javis_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tv_connection_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connection health"
                android:textColor="@color/javis_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@color/javis_red"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_connection_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not connected"
                android:textColor="@color/javis_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_whatsapp_link"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Link WhatsApp"
        android:backgroundTint="@color/javis_green"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_whatsapp_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="WhatsApp Settings"
        android:backgroundTint="@color/javis_surface"
        android:textColor="@color/javis_text_primary"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"/>

</LinearLayout>
