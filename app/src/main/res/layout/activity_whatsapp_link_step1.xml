<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/javis_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WHATSAPP"
        android:textColor="@color/javis_red"
        android:textSize="11sp"
        android:letterSpacing="0.2"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Linking"
        android:textColor="@color/javis_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="24dp"/>

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Creating a linked device session on this phone. Your WhatsApp account remains controlled by WhatsApp."
        android:textColor="@color/javis_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tv_pair_code_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="---- ----"
        android:textColor="@color/javis_text_primary"
        android:textSize="32sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:background="@drawable/bg_card"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Waiting for pairing..."
        android:textColor="@color/javis_text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="On your primary WhatsApp phone, go to Settings > Linked devices > Link a device > Link with phone number, then enter the code above."
        android:textColor="@color/javis_text_secondary"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_back"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Cancel"
        android:backgroundTint="@color/javis_surface"
        android:textColor="@color/javis_text_primary"/>

</LinearLayout>
