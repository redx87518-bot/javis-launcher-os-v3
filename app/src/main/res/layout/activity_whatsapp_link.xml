<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@color/javis_bg">

    <TextView
        android:id="@+id/tv_wa_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Link WhatsApp"
        android:textColor="@color/javis_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-light"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_wa_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connect your WhatsApp account"
        android:textColor="@color/javis_text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tv_connection_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Disconnected"
        android:textColor="@color/javis_red"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bg_pill"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/et_phone_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone number (e.g. +234XXXXXXXXXX)"
        android:textColor="@color/javis_text_primary"
        android:textColorHint="@color/javis_text_secondary"
        android:background="@drawable/bg_input"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:inputType="phone"
        android:maxLines="1"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_link_whatsapp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Link WhatsApp"
        android:backgroundTint="@color/javis_green"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="20dp"/>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_pair_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="---- ----"
        android:textColor="@color/javis_text_primary"
        android:textSize="28sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:paddingHorizontal="28dp"
        android:paddingVertical="18dp"
        android:background="@drawable/bg_card"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WhatsApp will open with the pairing code. Confirm on both devices to complete linking."
        android:textColor="@color/javis_text_secondary"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btn_pair"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Confirm Pairing"
        android:backgroundTint="@color/theme_blue_primary"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_disconnect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Disconnect"
        android:backgroundTint="@color/javis_red"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_clear_session"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Clear Session"
        android:backgroundTint="@color/javis_surface"
        android:textColor="@color/javis_text_primary"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"/>

</LinearLayout>
