<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/javis_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WHATSAPP"
        android:textColor="@color/javis_red"
        android:textSize="11sp"
        android:letterSpacing="0.2"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connected"
        android:textColor="@color/javis_text_primary"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tv_whatsapp_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone: +234XXXXXXXXXX"
        android:textColor="@color/javis_text_primary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_whatsapp_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Linked device active"
        android:textColor="@color/javis_green"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_whatsapp_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="WhatsApp Settings"
        android:backgroundTint="@color/javis_surface"
        android:textColor="@color/javis_text_primary"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_whatsapp_disconnect"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Disconnect"
        android:backgroundTint="@color/javis_red"
        android:textColor="@color/white"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_clear_session"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Clear Session"
        android:backgroundTint="@color/javis_surface"
        android:textColor="@color/javis_text_primary"/>

</LinearLayout>
